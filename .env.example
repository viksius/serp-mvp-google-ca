# Copy this file to .env and paste your keys (no quotes, no comments on the same line).
SERPAPI_KEY=
ANTHROPIC_API_KEY=

# Optional
# LLM_MODEL=claude-haiku-5-5
# LLM_WORKERS=4
# Price per 1M tokens in USD: the run prints the LLM cost when both are set
PRICE_IN_PER_MTOK=0.10
PRICE_OUT_PER_MTOK=0.50

# Cost guards for the LLM step (command-line flags override these)
# LLM_MAX_CALLS=100
# LLM_TOKEN_BUDGET=400000

# Google Sheets (optional, see apps_script/README.md)
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
